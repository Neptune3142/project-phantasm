# =============================================================================
# PROJECT PHANTASM — Environment Configuration Template
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- Google Gemini AI ---------------------------------------------------------
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# A currently-supported model. Defaults to gemini-2.5-flash if unset.
# Other valid options: gemini-2.5-pro, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# --- n8n Automation ------------------------------------------------------------
# Obtain from your local n8n instance → Workflow → Webhook node → "Production URL"
N8N_BASE_URL=http://localhost:5679
N8N_WEBHOOK_URL=http://localhost:5679/webhook/phantasm-exorcism
# Optional: n8n API key (Settings → n8n API) if you use the REST API
N8N_API_KEY=

# --- Google Sheets Audit Ledger -----------------------------------------------
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Enable Google Sheets API. Use the OAuth playground flow for a refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# The spreadsheet ID is the long string in the Sheet URL between /d/ and /edit
GOOGLE_SHEET_ID=

# --- Gmail Incident Notifications ---------------------------------------------
GMAIL_SENDER=
GMAIL_RECIPIENT=

# --- Database -----------------------------------------------------------------
# SQLite (async driver) for local dev. For PostgreSQL use:
#   postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./phantasm.db

# --- Application --------------------------------------------------------------
# development | staging | production
APP_ENV=development
# When true, the app runs entirely on local simulation adapters.
SIMULATION_MODE=true
# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
